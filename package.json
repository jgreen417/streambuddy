{
	"displayName": "streamBuddy",
	"description": "Your friends' Letterboxd ratings plus Letterboxd and IMDb scores on Netflix, Prime Video, HBO Max, Disney+, Crunchyroll and Tubi.",
	"name": "streambuddy",
	"version": "1.1.0",
	"scripts": {
		"web-ext": "web-ext run",
		"firefox": "web-ext run --keep-profile-changes --firefox-profile=test2",
		"chrome": "web-ext run --source-dir dist/chrome/ -t chromium",
		"build": "npm run build:chrome && npm run build:firefox && tsx scripts/zip.ts",
		"build:chrome": "cross-env SOURCE_DATE_EPOCH=1234567890 NODE_ENV=production vite build -c vite.chrome.config.ts",
		"build:release": "cross-env RELEASE=1 TMDB_TOKEN= LETTERBOXD_USERNAME= OUT_DIR=release npm run build:chrome",
		"build:release:firefox": "cross-env RELEASE=1 TMDB_TOKEN= LETTERBOXD_USERNAME= OUT_DIR=release npm run build:firefox",
		"build:source": "git archive --format=zip --prefix=streambuddy-source/ -o release/streambuddy-source.zip HEAD",
		"build:firefox": "cross-env SOURCE_DATE_EPOCH=1234567890 NODE_ENV=production vite build -c vite.firefox.config.ts",
		"dev": "concurrently \"npm run dev:chrome\" \"npm run dev:firefox\"",
		"dev:chrome": "cross-env NODE_ENV=development vite build --mode development --watch  -c vite.chrome.config.ts",
		"dev:firefox": "cross-env NODE_ENV=development vite build --mode development --watch -c vite.firefox.config.ts",
		"format": "prettier --write .",
		"lint": "eslint . --fix --cache",
		"lint:manifest": "web-ext lint",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:visual": "playwright test",
		"test:visual:update": "playwright test --update-snapshots=changed",
		"sites:capture": "tsx e2e/sites/capture.ts",
		"sites:check": "tsx e2e/sites/check.ts",
		"sites:report": "tsx e2e/sites/report.ts",
		"sites:workbench": "tsx e2e/sites/workbench.ts",
		"typecheck": "vue-tsc --noEmit",
		"tokens": "tsx scripts/design-tokens.ts"
	},
	"dependencies": {
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"marked": "^18.1.1",
		"pinia": "^4.1.0",
		"vue": "^3.5.41",
		"vue-i18n": "^11.4.16",
		"vue-router": "^5.4.0",
		"webextension-polyfill": "^0.12.0"
	},
	"devDependencies": {
		"@crxjs/vite-plugin": "^3.0.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/mdi": "^1.2.3",
		"@intlify/unplugin-vue-i18n": "^11.2.7",
		"@playwright/test": "1.56.1",
		"@types/node": "^26.6.5",
		"@types/pngjs": "^6.0.5",
		"@types/webextension-polyfill": "^0.12.6",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "^5.0.4",
		"@vitest/ui": "^5.0.5",
		"@vue/compiler-sfc": "^3.5.41",
		"@vueuse/core": "^15.0.0",
		"archiver": "^8.0.0",
		"chalk": "^6.0.1",
		"chrome-types": "^0.1.459",
		"concurrently": "^10.0.4",
		"cross-env": "^10.1.0",
		"daisyui": "^5.7.50",
		"dependency-cruiser": "^18.7.0",
		"dotenv": "^18.0.9",
		"esbuild": "^0.28.2",
		"eslint": "^10.13.0",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"pixelmatch": "^7.2.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.9.10",
		"source-map-js": "^1.2.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"unplugin-auto-import": "^21.1.0",
		"unplugin-icons": "^24.0.0",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.3.5",
		"vite-plugin-html": "^3.2.2",
		"vite-plugin-vue-devtools": "^8.2.1",
		"vite-plugin-zip-pack": "^1.2.4",
		"vitest": "^5.0.4",
		"vue-tsc": "^3.3.13",
		"web-ext": "^10.8.0",
		"webext-bridge": "^6.0.1"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/jgreen417/streambuddy.git"
	},
	"type": "module",
	"optionalDependencies": {
		"win-node-env": "^0.6.1"
	},
	"author": "Josh Green",
	"contributors": [
		"Marvin Krebber (original Streaming enhanced extension)"
	],
	"license": "GPL-3.0",
	"bugs": {
		"url": "https://github.com/jgreen417/streambuddy/issues"
	},
	"homepage": "https://github.com/jgreen417/streambuddy#readme",
	"webExt": {
		"sourceDir": "dist/firefox"
	},
	"overrides": {
		"fx-runner": {
			"shell-quote": "^1.12.0"
		}
	}
}
